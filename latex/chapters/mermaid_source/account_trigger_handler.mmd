flowchart TD
    Start([Account Trigger]) --> TriggerContext{"Insert/Update?"}
    
    TriggerContext -->|"Before Insert"| CheckDups["Check for Duplicates"]
    TriggerContext -->|"After Update"| MdrProcessing["MDR Processing"]
    
    CheckDups --> EmailPhone{"Email/Phone Match?"}
    
    EmailPhone -->|"Yes"| CalculateSim["Calculate Similarity"]
    EmailPhone -->|"No"| NoMatch["No Action"]
    
    CalculateSim --> Score{"Score > 85%?"}
    Score -->|"Yes"| AutoMerge["Auto-Merge"]
    Score -->|"No"| CreateTask["Create Review Task"]
    
    AutoMerge --> Audit["Create Audit Record"]
    
    MdrProcessing --> MDRCheck{"MDR Qualifying?"}
    MDRCheck -->|"Yes"| Enrich["Enrich Account"]
    MDRCheck -->|"No"| NoAction["No Action"]
    
    %% Simple styling
    classDef decision fill:#a7e,stroke:#333
    classDef action fill:#79d,stroke:#333
    
    class TriggerContext,EmailPhone,Score,MDRCheck decision
    class Start,CheckDups,CalculateSim,AutoMerge,CreateTask,Audit,MdrProcessing,Enrich,NoAction,NoMatch action 