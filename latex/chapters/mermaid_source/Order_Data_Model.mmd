    %% Force horizontal layout
    ACCOUNT ||--o{ ORDER : places
    PRODUCT }o--|| ORDER_ITEM : used_in
    ORDER ||--o{ ORDER_ITEM : contains
    ORDER ||--o{ PAYMENT : has
    
    ACCOUNT {
        string Id
        string FirstName
        string LastName
        string Email
        string CustomerTier
    }
    
    ORDER {
        string Id
        string OrderNumber
        date OrderDate
        decimal TotalAmount
        string Status
        string Channel
    }
    
    PAYMENT {
        string Id
        string OrderId
        string Method
        decimal Amount
        string Status
    }
    
    ORDER_ITEM {
        string Id
        string OrderId
        string ProductId
        int Quantity
        decimal UnitPrice
        decimal TotalPrice
    }
    
    PRODUCT {
        string Id
        string SKU
        string Name
        string Category
        string Collection
    }

